---
import { menuData_sub } from "../const/menu";
import Layout from "../layouts/Layout.astro";
---

<Layout title="各種規約">
	<article id="pageContainer" class="terms" data-pageId="other">
        <section class="pageHeading">
            <h1>Terms & Policies</h1>
            <p>各種規約</p>
        </section>
        <div class="terms_wrapper">
            <nav class="terms_nav" aria-label="Terms Navigation">
                <ul class="terms_nav_list">
                    {menuData_sub.map((item) => (
                        <li>
                            <a href={item.href}>
                                {item.index}. {item.title}
                            </a>
                        </li>
                    ))}
                </ul>
            </nav>
            <div class="terms_sections">
                {menuData_sub.map((item) => (
                    <section class="terms_section" data-href={item.href}>
                        <h2>{item.index}. {item.title} {item.titleEn && <>/ {item.titleEn}</>}</h2>
                        <div class="terms_block" set:html={item.content}></div>
                        <div class="terms_section_smooth" id={item.id}></div>
                    </section>
                ))}
            </div>
        </div>
    </article>
</Layout>