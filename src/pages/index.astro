---
import Address from '../components/Address.astro';
import SectionHeading from '../components/SectionHeading.astro';
import { toAccess, toFaq } from '../const/menu';
import Layout from '../layouts/Layout.astro';
import { zeroPad } from '../utils/calc';
import src_map from "../assets/dev/map.png"
import Image from 'astro/components/Image.astro';
import src_fv from "../assets/top/fv.jpg"
import SlTexts from '../components/SlTexts.astro';
import ShowImg from '../components/ShowImg.astro';
import src_concept from "../assets/top/concept.jpg"
import Facility from '../components/Facility.astro';
import Others from '../components/Others.astro';
import Gallery from '../components/Gallery.astro';
import Faq from '../components/Faq.astro';

---

<Layout>
	<article id="pageContainer" class="top" data-pageId="top">
		<section class="fv --header_white">
			<div class="fv_bg">
				<Image class="fv_bg_img" src={src_fv} alt={""} fetchpriority={"high"} loading={"eager"} />
			</div>
			<div class="fv_texts">
				<p class='fv_texts_main'>
					<SlTexts tag='span' texts={["BREATH,"]} noSplit noInview noClip />&nbsp;
					<SlTexts tag='span' texts={["CALL,"]} noSplit noInview noClip/>&nbsp;
					<SlTexts tag='span' texts={["BELONG."]} noSplit noInview noClip/>
				</p>
				<h1 class="fv_texts_sub">
					<span>呼吸するように、過ごす</span><br />
					<span>一棟貸切の宿。</span>
				</h1>
			</div>
			<div class="fv_shutter"></div>
		</section>
		<section class="concept" id="concept">
			<h2 class="concept_heading">CONCEPT</h2>
			<div class="cencept_caths">
				<h3 class="cencept_cath --en">
					<span>PRACE FOR YOU<br /></span>
					<span>TO REST YOUR<br /></span>
					<span>HEART</span>
				</h3>
				<p class="cencept_cath --jp"><span>呼吸するように、過ごす<br /></span><span>一棟貸切の宿。</span></p>
			</div>
			<div class="cencept_itemBox">
				<ShowImg src={src_concept} />
				<p class="cencept_text">
					時間を継いで、かわりながら育っていく宿。<br />
					築50年の民家をリノベーションした、<br />
					一棟貸切の空間。
				</p>
			</div>
		</section>
		<Facility />
		<Others />
		<section class="floor">
			<SectionHeading main={"Floor Map"} sub='マウスホバー / タップで画像が表示されます。' />
			<div class="floor_wrapper">
				<p>コンテンツ確定後実装</p>
			</div>
		</section>
		<Gallery />
		<section class="access" id="access">
			<div class="access_wrapper">
				<div class="access_text">
					<SectionHeading main={toAccess.title} />
					<p>
						<Address />
					</p>
					<h3>お車でお越しの方</h3>
					<p>
						東京湾アクアライン経由。<br />
						東京都心から木更津エリアまで約40分〜。<br /><br />
						駐車場は無料でご利用いただけます。
					</p>
					<h3>公共交通機関でお越しの方</h3>
					<p>
						東京・渋谷・品川方面から木更津駅まで、高速バスで約60分。<br /><br />
						東京駅からJR特急で約55分。<br /><br />
						木更津駅からKOMA HOUSEまでは、<br />
						徒歩約13分 / 車で約5分。
					</p>
					<hr />
					<SectionHeading main={"SPEC"} />
					<h3>収容人数</h3>
					<p>
						大人10名まで<br />
						<small>※未就学児の添い寝は宿泊人数に含みません。</small>
					</p>
					<h3>チェックイン</h3>
					<p>
						14:00〜<br />
					</p>
					<h3>チェックアウト</h3>
					<p>
						〜11:00<br />
					</p>
					<h3>駐車場</h3>
					<p>
						無料<br />
					</p>
				</div>
				<Image class="access_img" src={src_map} alt="" />
			</div>
		</section>
		<Faq />
	</article>
</Layout>
