---
import Address from '../components/Address.astro';
import SectionHeading from '../components/SectionHeading.astro';
import { toAccess, toPet } from '../const/menu';
import Layout from '../layouts/Layout.astro';
import src_map from "../assets/dev/map.png"
import Image from 'astro/components/Image.astro';
import src_fv from "../assets/top/fv.jpg"
import src_fv_row from "../assets/top/fv_row.jpg"
import SlTexts from '../components/SlTexts.astro';
import ShowImg from '../components/ShowImg.astro';
import src_concept from "../assets/top/concept.jpg"
import Facility from '../components/Facility.astro';
import Others from '../components/Others.astro';
import Gallery from '../components/Gallery.astro';
import Faq from '../components/Faq.astro';
import LogoHori from '../components/LogoHori.astro';
import ProgressiveImage from '../components/ProgressiveImage.astro';
import src_1f from "../assets/top/map.png"
// import src_2f from "../assets/top/map_2f.jpg"
import MainButton from '../components/mainButton.astro';

---

<Layout>
	<article id="pageContainer" class="top" data-pageId="top">
		<section class="fv --header_white">
			<div class="fv_bg">
				<Image src={src_fv} alt={""} class:list={"fv_bg_img"} />
				<!-- <ProgressiveImage row={src_fv} src={src_fv}  className='fv_bg_img' /> -->
			</div>
			<div class="fv_texts">
				<p class='fv_texts_main'>
					<SlTexts tag='span' texts={["GROWING"]} noSplit noInview noClip />&nbsp;
					<SlTexts tag='span' texts={["OLDER,"]} noSplit noInview noClip/>&nbsp;
					<SlTexts tag='span' texts={["TOGETHER."]} noSplit noInview noClip/>
				</p>
				<LogoHori />
				<h1 class="fv_texts_sub">
					時間を継いで、<br />かわりながら育っていく宿。
				</h1>
			</div>
			<div class="fv_shutter"></div>
		</section>
		<section class="concept" id="concept">
			<h2 class="concept_heading">CONCEPT</h2>
			<div class="cencept_caths">
				<h3 class="cencept_cath --en">
					<span>PRACE FOR YOU<br /></span>
					<span>TO REST YOUR<br /></span>
					<span>HEART</span>
				</h3>
				<p class="cencept_cath --jp"><span>それぞれのペースで過ごす、<br /></span><span>一棟貸切の宿。</span></p>
			</div>
			<div class="cencept_itemBox">
				<ShowImg src={src_concept} />
				<p class="cencept_text">
					時間を継いで、かわりながら育っていく宿。<br />
					築50年の民家をリノベーションした、<br />
					一棟貸切の空間。
				</p>
			</div>
		</section>
		<Facility />
		<Others />
		<section class="floor">
			<div class="floor_texts">
				<SectionHeading main={"Floor Map"} />
			</div>
			<div class="map">
				<div class="map_inner">
					<Image class:list={"floor_map"} src={src_1f} alt={""} />
				</div>
				<button
					class="map_barrier"
					type="button"
					aria-label="マップを操作する"
				>
					<span>
						<span class="--pulse">クリックして操作を開始</span>
					</span>
				</button>
				<button class="map_guide">
					<div class="--open">
						ドラッグ … 移動<br />
						ピンチ / ホイール … 拡大縮小
					</div>
				</button>
			</div>
		</section>
		<Gallery />
		<section class="access" id="access">
			<div class="access_wrapper">
				<div class="access_text">
					<div class="access_block">
						<SectionHeading main={toAccess.title} />
						<p class="access_block_content">
							<Address /><br /><br />
							<span class="--indent">
								お車でお越しの方<br />
								東京湾アクアライン経由、都心から約40分<br />
								駐車場あり（無料）
							</span><br /><br />
							<span class="--indent">
								電車・バスでお越しの方<br />
								高速バス：東京・渋谷・品川 各駅 → 「木更津駅」約60分<br />
								JR特急：東京駅 → 「木更津駅」約55分<br />
								木更津駅から徒歩 約13分／タクシー 約5分
							</span>
						</p>
					</div>
					<div class="access_block">
						<SectionHeading main={"Information"} />
						<p class="access_block_content">
							<span class="--table">
								<span class="--th">Check In</span><span>14:00〜</span>
							</span><br />
							<span class="--table">
								<span class="--th">Check Out</span><span>〜11:00</span>
							</span><br /><br />
							<span class="--table">
								<span class="--th">定員</span><span>大人10名まで</span><br />
								<small>＊未就学児の添い寝は宿泊人数に含みません</small>
							</span><br /><br />
							<span class="--indent">
								<span>
									ペット可<br />
									大切な家族と、同じ時間を。<br />
									室内だけでなく、庭でも自由に過ごせる宿です。<br />
									くつろぐ愛犬の姿も、旅の大切な一コマに。<br />
									<small>＊<a href={`${toPet.href}`}>利用条件</a>がございますので、事前にご確認ください。</small>
								</span>
							</span>
						</p>
					</div>
					<div class="access_block">
						<SectionHeading main={"Facilities"} />
						<div class="access_block_content --faci">
							<ul class="access_block_grid">
								<li class="--indent">
									室内設備<br />
									冷暖房<br />
									Wi-Fi<br />
									空気清浄機<br />
									洗濯機<br />
									ワークスペース
								</li>
								<li class="--indent">
									バス・洗面<br />
									洗面台 × 2<br />
									ウォッシュレットトイレ<br />
									ドライヤー<br />
									サウナ<br />
									水風呂
								</li>
								<li class="--indent">
									キッチン<br />
									4口コンロ<br />
									冷蔵庫<br />
									電子レンジ<br />
									オーブントースター<br />
									ケトル<br />
									調理器具<br />
									食器<br />
									カトラリー<br />
									子ども用食器
								</li>
								<li class="--indent">
									屋外設備<br />
									BBQセット<br />
									デッキチェア × 4<br />
									デッキソファ × 1<br />
									外気浴チェア × 2
								</li>
								<li class="--indent">
									寝具<br />
									1F シングルマットレス × 6枚<br />
									2F セミダブルマットレス × 4枚
								</li>
							</ul><br />
							<p class="--indent">
								<span>
									アメニティ<br />
									触れるものから、心地よく。<br />
									使い心地だけでなく、<br />
									ものづくりの背景にも共感できるものを選びました。<br />
									nakedfact | Face & Body Soap<br />
									ORMONICA | Shampoo & Conditioner<br />
									YOBEK | Hand Wash<br />
									<small>＊季節や仕入れ状況により変わることがあります。予めご了承ください。</small>
								</span>
							</p>
						</div>
					</div>
				</div>
				<Image class="access_img" src={src_map} alt="" />
			</div>
		</section>
		<Faq />
	</article>
</Layout>
