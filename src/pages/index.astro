---
import Address from '../components/Address.astro';
import SectionHeading from '../components/SectionHeading.astro';
import { toAccess, toFaq } from '../const/menu';
import { address } from '../const/tips';
import Layout from '../layouts/Layout.astro';
import { zeroPad } from '../utils/calc';
import src_map from "../assets/dev/map.png"
import Image from 'astro/components/Image.astro';

const faq = [
	{
		q: "設備について教えてください。",
		a: `
			以下のご用意がございます。<br /><br />
			室内設備：<br />
			冷暖房<br />
			Wi-Fi<br />
			空気清浄機<br />
			洗濯機<br />
			ワークスペース<br />
			....
		`,
	},
	{
		q: "設備について教えてください。",
		a: `
			以下のご用意がございます。<br /><br />
			室内設備：<br />
			冷暖房<br />
			Wi-Fi<br />
			空気清浄機<br />
			洗濯機<br />
			ワークスペース<br />
			....
		`,
	},
	{
		q: "設備について教えてください。",
		a: `
			以下のご用意がございます。<br /><br />
			室内設備：<br />
			冷暖房<br />
			Wi-Fi<br />
			空気清浄機<br />
			洗濯機<br />
			ワークスペース<br />
			....
		`,
	},
]
---

<Layout>
	<article id="pageContainer" class="top" data-pageId="top">
		<section class="fv"></section>
		<section class="concept"></section>
		<section class="facility"></section>
		<search class="others"></search>
		<section class="floor">
			<SectionHeading main={"Floor Map"} sub='マウスホバー / タップで画像が表示されます。' />
			<div class="floor_wrapper">
				<p>コンテンツ確定後実装</p>
			</div>
		</section>
		<section class="gallery">
			<SectionHeading main={"Gallery"} sub='高画質な写真で施設をご確認いただけます。' />
		</section>
		<section class="access">
			<div class="access_wrapper">
				<div class="access_text">
					<SectionHeading main={toAccess.title} />
					<p>
						<Address />
					</p>
					<h3>お車でお越しの方</h3>
					<p>
						東京湾アクアライン経由。<br />
						東京都心から木更津エリアまで約40分〜。<br /><br />
						駐車場は無料でご利用いただけます。
					</p>
					<h3>公共交通機関でお越しの方</h3>
					<p>
						東京・渋谷・品川方面から木更津駅まで、高速バスで約60分。<br /><br />
						東京駅からJR特急で約55分。<br /><br />
						木更津駅からKOMA HOUSEまでは、<br />
						徒歩約13分 / 車で約5分。
					</p>
				</div>
				<Image class="access_img" src={src_map} alt="" />
			</div>
		</section>
		<section class="faq">
			<SectionHeading main={toFaq.title} />
			<ul class="faqList">
				{faq.map((item, index) => (
					<li class="faqList_card --accordion">
						<button class="faqList_card_q --accordion_button">
							<p class="faqList_card_q_number">{zeroPad(index + 1, 2)}</p>
							<p class="faqList_card_q_title">{item.q}</p>
							<svg class="faqList_card_q_icon --accordion_head_icon" width="27" height="27" viewBox="0 0 27 27" fill="none" xmlns="http://www.w3.org/2000/svg">
								<rect x="7" y="13" width="13" height="1"/>
								<rect x="14" y="7" width="13" height="1" transform="rotate(90 14 7)"/>
							</svg>
						</button>
						<div class="faqList_card_a --accordion_body">
							<p class="faqList_card_a_inner --accordion_bodyInner" set:html={item.a}></p>
						</div>
					</li>
				))}
			</ul>
		</section>
	</article>
</Layout>
