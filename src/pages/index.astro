---
import Address from '../components/Address.astro';
import SectionHeading from '../components/SectionHeading.astro';
import { toAccess } from '../const/menu';
import Layout from '../layouts/Layout.astro';
import src_map from "../assets/dev/map.png"
import Image from 'astro/components/Image.astro';
import src_fv from "../assets/top/fv.jpg"
import src_fv_row from "../assets/top/fv_row.jpg"
import SlTexts from '../components/SlTexts.astro';
import ShowImg from '../components/ShowImg.astro';
import src_concept from "../assets/top/concept.jpg"
import Facility from '../components/Facility.astro';
import Others from '../components/Others.astro';
import Gallery from '../components/Gallery.astro';
import Faq from '../components/Faq.astro';
import LogoHori from '../components/LogoHori.astro';
import ProgressiveImage from '../components/ProgressiveImage.astro';
import src_1f from "../assets/top/map.jpg"
// import src_2f from "../assets/top/map_2f.jpg"
import MainButton from '../components/mainButton.astro';

---

<Layout>
	<article id="pageContainer" class="top" data-pageId="top">
		<section class="fv --header_white">
			<div class="fv_bg">
				<ProgressiveImage row={src_fv_row} src={src_fv}  className='fv_bg_img' />
			</div>
			<div class="fv_texts">
				<p class='fv_texts_main'>
					<SlTexts tag='span' texts={["GROWING"]} noSplit noInview noClip />&nbsp;
					<SlTexts tag='span' texts={["OLDER,"]} noSplit noInview noClip/>&nbsp;
					<SlTexts tag='span' texts={["TOGETHER."]} noSplit noInview noClip/>
				</p>
				<LogoHori />
				<h1 class="fv_texts_sub">
					時間を継いで、<br />かわりながら育っていく宿。
				</h1>
			</div>
			<div class="fv_shutter"></div>
		</section>
		<section class="concept" id="concept">
			<h2 class="concept_heading">CONCEPT</h2>
			<div class="cencept_caths">
				<h3 class="cencept_cath --en">
					<span>PRACE FOR YOU<br /></span>
					<span>TO REST YOUR<br /></span>
					<span>HEART</span>
				</h3>
				<p class="cencept_cath --jp"><span>それぞれのペースで過ごす、<br /></span><span>一棟貸切の宿。</span></p>
			</div>
			<div class="cencept_itemBox">
				<ShowImg src={src_concept} />
				<p class="cencept_text">
					時間を継いで、かわりながら育っていく宿。<br />
					築50年の民家をリノベーションした、<br />
					一棟貸切の空間。
				</p>
			</div>
		</section>
		<Facility />
		<Others />
		<section class="floor">
			<div class="floor_texts">
				<SectionHeading main={"Floor Map"} />
			</div>
			<div class="map">
				<div class="map_inner">
					<Image class:list={"floor_map"} src={src_1f} alt={""} />
				</div>
				<button
					class="map_barrier"
					type="button"
					aria-label="マップを操作する"
				>
					<span>
						<span class="--pulse">クリックして操作を開始</span>
					</span>
				</button>
				<button class="map_guide">
					<div class="--open">
						ドラッグ … 移動<br />
						ピンチ / ホイール … 拡大縮小
					</div>
				</button>
			</div>
		</section>
		<Gallery />
		<section class="access" id="access">
			<div class="access_wrapper">
				<div class="access_text">
					<SectionHeading main={toAccess.title} />
					<p>
						<Address />
					</p>
					<h3>お車でお越しの方</h3>
					<p>
						東京湾アクアライン経由、都心から約40分<br />
						駐車場あり（無料）
					</p>
					<h3>電車・バスでお越しの方</h3>
					<p>
						高速バス：東京・渋谷・品川 各駅 → 「木更津駅」約60分<br />
						JR特急：東京駅 → 「木更津駅」約55分<br />
						木更津駅から徒歩 約13分／タクシー 約5分
					</p>
					<hr />
					<SectionHeading main={"SPEC"} />
					<h3>Check In</h3>
					<p>
						14:00〜<br />
					</p>
					<h3>Check Out</h3>
					<p>
						〜11:00<br />
					</p>
					<h3>定員</h3>
					<p>
						大人10名まで<br />
						<small>＊未就学児の添い寝は宿泊人数に含みません</small><br />
						<small>＊ペット可</small>
					</p>
				</div>
				<Image class="access_img" src={src_map} alt="" />
			</div>
		</section>
		<Faq />
	</article>
</Layout>
