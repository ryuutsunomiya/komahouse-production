---
import Image from "astro/components/Image.astro"
import src_01 from "../assets/top/gallery/kmhk_056.jpg"
import src_03 from "../assets/top/facility/facility_03.jpg"
import src_04 from "../assets/top/facility/facility_04.jpg"
import src_05 from "../assets/top/facility/facility_05.jpg"
import src_07 from "../assets/top/facility/facility_07.jpg"
import src_08 from "../assets/top/facility/facility_08.jpg"
import src_09 from "../assets/top/facility/facility_09.jpg"
import { zeroPad } from "../utils/calc"

const data = [
    {
        title: "LIVING / リビング",
        detail: "くつろぐための、ゆったりとしたソファ。<br />話す人、料理する人、何もしない人。<br />思い思いの場所で過ごせます。",
        src: src_01,
    },
    {
        title: "TERRACE / テラス",
        detail: "星を眺めたり、ただ風に吹かれたり。<br />室内とは少し違う時間が流れる場所です。",
        src: src_03,
        // kmhk_008
    },
    {
        title: "DINING ROOM / ダイニング",
        detail: "土間のある玄関から、暮らしは始まります。<br />旧家の柱をダイニングテーブルに変え、その木目と時間をそのまま生かしました。今の暮らしに合う、新しい形へ。<br />時を重ねた木のぬくもりを。",
        src: src_04,
        // kmhk_108
    },
    {
        title: "WORKSPACE / ワークスペース",
        detail: "2階に設けた、小さな仕事部屋。<br />同じ家にいながら、少しだけ離れて集中できます。",
        src: src_05,
        // kmhk_075
    },
    {
        title: "BATH / 風呂",
        detail: "ゆったりと足を伸ばせる、大きめの浴槽。<br />窓の外に植栽を配し、緑や外気を感じられます。<br />洗面台は2台。支度も並んでできます。",
        src: src_07,
        // kmhk_082
    },
    {
        title: "SAUNA / サウナ",
        detail: "身体を温め、呼吸を整える。<br />ゆっくりと自分に戻る時間を。<br />水風呂も併設しています。",
        src: src_08,
        // kmhk_098
    },
    {
        title: "GARDEN / 庭",
        detail: "季節とともに、少しずつ育っていく庭。<br />訪れるたびに、違う表情に出会えます。",
        src: src_09,
        // kmhk_002
    },
]
---


<section class="facility --header_white" id="facility">
    <div class="facilityList">
        <div class="facilityList_sticky">
            <div class="facilityList_sticky_imgs">
                {data.map((item, index) => (
                    <Image class="facilityList_sticky_img" src={item.src} alt={""} fetchpriority={index === 0 ? "high" : "low"} loading={index === 0 ? "eager" : "lazy"}  />
                ))}
            </div>
            <div class="facilityList_sticky_wrapper">
                <div class="facilityList_sticky_textLeft">
                    <div class="facilityList_sticky_numbers">
                        <p class="facilityList_sticky_numbers_number">
                            {data.map((_, index) => (<span class="--counter">FACILITY&ensp;{zeroPad(index + 1, 2)}</span>))}
                        </p>
                    </div>
                    <div class="facilityList_sticky_title">
                        {data.map((item) => (
                            <h3 class="facilityList_sticky_title_inner">{item.title}</h3>
                        ))}
                    </div>
                </div>
                <div class="facilityList_sticky_textRight">
                    {data.map((item) => (
                        <p class="facilityList_sticky_textRight_inner" set:html={item.detail}></p>
                    ))}
                </div>
            </div>
        </div>
        <div class="facilityList_scroll">
            {
                [...Array(data.length + 1)].map(() => (
                    <div></div>
                )
            )}
        </div>
    </div>
</section>