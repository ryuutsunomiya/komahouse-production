---
import Image from "astro/components/Image.astro"
import src_01 from "../assets/top/facility/facility_01.jpg"
import src_02 from "../assets/top/facility/facility_02.jpg"
import src_03 from "../assets/top/facility/facility_03.jpg"
import { zeroPad } from "../utils/calc"


const data = [
    {
        title: "LIVING / リビング",
        detail: "くつろぐための、ゆったりとしたソファ。話す人、料理する人、何もしない人。思い思いの場所で過ごせます。",
        src: src_01,
    },
    {
        title: "KITCHEN / キッチン",
        detail: "口コンロを備え、複数人で同時に料理ができる広さに設計。買い出しをして、料理をして、みんなで食卓を囲む。その時間ごと楽しんでいただければ幸いです。",
        src: src_02,
    },
    {
        title: "TERRACE / テラス",
        detail: "星を眺めたり、ただ風に吹かれたり。<br />室内とは少し違う時間が流れる場所です。",
        src: src_03,
    },
]
---


<section class="facility --header_white" id="facility">
    <div class="facilityList">
        <div class="facilityList_sticky">
            <div class="facilityList_sticky_imgs">
                {data.map((item) => (
                    <Image class="facilityList_sticky_img" src={item.src} alt={""} />
                ))}
            </div>
            <div class="facilityList_sticky_wrapper">
                <div class="facilityList_sticky_textLeft">
                    <div class="facilityList_sticky_numbers">
                        <p class="facilityList_sticky_numbers_title">FACILITY</p>
                        <div class="facilityList_sticky_numbers_number">
                            <div class="--counter">
                                {data.map((_, index) => (
                                    <p>{zeroPad(index + 1, 2)}</p>
                                ))}
                            </div>
                            <p>{zeroPad(data.length, 2)}</p>
                        </div>
                    </div>
                    <div class="facilityList_sticky_title">
                        {data.map((item) => (
                            <h3>{item.title}</h3>
                        ))}
                    </div>
                </div>
                <div class="facilityList_sticky_textRight">
                    {data.map((item) => (
                        <p class="facilityList_sticky_textRight_inner" set:html={item.detail}></p>
                    ))}
                </div>
            </div>
        </div>
        <div class="facilityList_scroll">
            {
                [...Array(data.length)].map(() => (
                    <div></div>
                )
            )}
        </div>
    </div>
</section>