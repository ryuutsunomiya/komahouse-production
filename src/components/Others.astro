---
import ShowImg from "./ShowImg.astro";
import SubHeading from "./SubHeading.astro";
import src_02_01 from "../assets/top/others/others_2_1.jpg"
import src_02_02 from "../assets/top/gallery_row/kmhk_111.jpg"
import src_03_01 from "../assets/top/others/others_3_1.jpg"
import src_03_02 from "../assets/top/others/others_3_2.jpg"
import src_03_03 from "../assets/top/gallery_row/kmhk_025.jpg"
import ToggleBgSection from "./ToggleBgSection.astro";

const data = [
    {
        id: "mea",
        title: "Meal",
        catch: "食卓が、旅の記憶になる。",
        text: `
            食事の提供はありません。<br /><br />

            木更津の魚市場や近隣のお店で好きな食材を選び、<br />
            4口コンロのキッチンで自由に料理を。<br /><br />

            屋外BBQもご利用いただけます。
        `,
        imgs: [src_03_03, src_03_01],
        col: "beige",
    },
    {
        id: "bed",
        title: "Bedroom",
        catch: "灯りを落とせば、静けさだけが残る。",
        text: `
            気候の良い季節には窓を開けて、<br />自然の風を感じながら眠ることもできます。<br /><br />

            大人10名分の寝具をご用意し、<br />
            2階の寝室にはセミダブルマットレスを各部屋2枚、<br />

            1階リビングにはシングルマットレスを6枚ご用意しています。
        `,
        imgs: [src_02_01, src_02_02],
        col: "dimGrey",
    },
]
---


<section class="others">
    {data.map((item, index) => (
        <ToggleBgSection className={`others_block --${item.id}`} col={item.col}>
            <div class="others_texts">
                <SubHeading text={item.title} />
                <p class="others_catch" set:html={item.catch}></p>
                <p class="others_text" set:html={item.text}></p>
            </div>
            <div class={`others_imgs --${item.id}`}>
                <div class="others_imgs_inner">
                    {item.imgs.map((img) => (
                        <ShowImg src={img} noInview />
                    ))}
                </div>
            </div>
        </ToggleBgSection>
    ))}
</section>