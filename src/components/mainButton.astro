---
import HoverText from './HoverText.astro'

interface Props {
    href?: string
    text: string
    bg?: "none" | "black" | "white"
    border?: "inherit" | "none" | "black" | "white"
    isBlank?: boolean
    className?: string
}

const { href, text, bg="black", border="inherit", isBlank, className="" } = Astro.props;
const borderClassName = border === "inherit" ? bg : border;
const wrapperClassName = `${className} --bg_${bg} --border_${borderClassName} mainButton`;
---

{href ? (
    <a class={wrapperClassName} href={href} target={isBlank ? "_blank" : "_self"} rel={isBlank ? 'noopener noreferrer' : ""}>
        <HoverText text={text} />
    </a>
) : (
    <button class={wrapperClassName}>
        <HoverText text={text} />
    </button>
)}