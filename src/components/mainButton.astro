---
import HoverText from './HoverText.astro'

interface Props {
    href: string
    text: string
    bg?: "none" | "black"
    border?: "inherit" | "none" | "black"
    isBlank?: boolean
}

const { href, text, bg="black", border="inherit", isBlank } = Astro.props;
const borderClassName = border === "inherit" ? bg : border;
const wrapperClassName = `--bg_${bg} --border_${borderClassName} mainButton`;
---

<a class={wrapperClassName} href={href} target={isBlank ? "_blank" : "_self"} rel={isBlank ? 'noopener noreferrer' : ""}>
    <HoverText text={text} />
</a>