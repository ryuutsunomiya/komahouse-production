---
import { menuData_Follow, menuData_main, menuData_sub } from '../const/menu';
import HoverText from './HoverText.astro';
import Image from 'astro/components/Image.astro';
import src_thum from "../assets/menu_thum.jpg"
import Address from './Address.astro';

interface Props {
    label: string,
    type: "header" | "footer"
}

const { label, type } = Astro.props;

const subs = [{title: "Terms", contents: menuData_sub}, {title: "Follow", contents: menuData_Follow}]
---

<nav class="mainNav" aria-label={label}>
    <ul class="mainNav_main">
        {menuData_main.map((item) => (
            <li class="mainNav_main_item">
                <a href={item.href} class="mainNav_main_anchor">
                    <HoverText text={item.title} />
                </a>
            </li>
        ))}
    </ul>
    <div class="mainNav_subs">
        {subs.map((sub) => (
            <div class="mainNav_sub">
                <h3 class="mainNav_sub_title">{sub.title}</h3>
                <ul class="mainNav_sub_items">
                    {sub.contents.map((item) => (
                        <li class="mainNav_sub_item">
                            <a href={item.href} class="mainNav_sub_anchor" target={item.isBlank ? "_blank" : "_self"} rel={item.isBlank ? 'noopener noreferrer' : ""}>
                                <HoverText text={item.title} />
                            </a>
                        </li>
                    ))}
                </ul>
            </div>
        ))}
        <div class="mainNav_sub">
            <h3 class="mainNav_sub_title">Access</h3>
            <p class="mainNav_sub_items">
                <Address />
            </p>
        </div>
    </div>
    <div class="mainNav_thum">
        { type === "header" ? (
            <Image src={src_thum} alt="" />
        ) : (
