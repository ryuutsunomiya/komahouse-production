---
import Image from 'astro/components/Image.astro'

interface Props {
    row: ImageMetadata
    src: ImageMetadata
    className?: string
}

const {row,  src, className=""} = Astro.props
---

<Image
  class={`progressiveImage ${className}`}
  src={row}
  data-src={src.src}
  alt=""
  fetchpriority="high"
  loading="eager"
>