---
import HeaderContent from "./HeaderContent.astro";
import MainNav from "./MainNav.astro";
import Loading from "./Loading.astro";
interface Props {
    isTop?: boolean
}

const { isTop } = Astro.props
---

<header class={isTop ? "header js--noAnime --initWhite" : "header js--noAnime"}>
    <HeaderContent menuText="MENU" />
    <div class="hamburger --close">
        <div class="hamburger_scroll">
            <MainNav type="header" label="Header Navigation" />
        </div>
        <HeaderContent menuText="CLOSE" />
    </div>
    <Loading />
</header>