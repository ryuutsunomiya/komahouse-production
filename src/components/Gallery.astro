---

<section class="gallery">
    <SectionHeading main={"Gallery"} sub='高画質な写真で施設をご確認いただけます。' />
    <div class="gallerySlider">
        <div class="gallerySlider_nav">
            <div class="gallerySlider_nav_scroll" data-lenis-prevent>
                <ul class="gallerySlider_nav_items">
                    {sliderData_row.map((item, index) => (
                        <div class="gallerySlider_nav_item">
                            <div class="gallerySlider_nav_item_inner">
                                <Image src={item} alt={""} />
                            </div>
                        </div>
                    ))}
                </ul>
            </div>
        </div>
        <div class="gallerySlider_window">
            {sliderData.map((item, index) => (
                <div class={index === 0 ? "gallerySlider_window_item" : "gallerySlider_window_item js--hidden"}>
                    { index < 2 ? (<Image src={item} alt={""} loading={"eager"} fetchpriority={"high"} />) : (<img src="" alt="" data-src={item.src} width={item.width} height={item.height} />) }
                </div>
            ))}
        </div>
    </div>
</section>