---
import 'destyle.css';
import '../styles/global.sass';
import '../styles/components.sass';
import '../styles/pages.sass';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';

interface Props {
	title?: string;
	description?: string;
	ogType?: 'website' | 'article';
}

const { title, description: pageDescription, ogType = 'website', } = Astro.props;

const baseDescription = "";
const description = pageDescription ? pageDescription : baseDescription;

const baseTitle = 'KOMA HOUSE';
const pageTitle = title ? `${title} - ${baseTitle}` : baseTitle;

const pageUrl = Astro.url.href;
const ogpUrl = new URL('/ogp.png', Astro.url.origin).href;
---

<!doctype html>
<html lang="ja">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />

    <title>{pageTitle}</title>
    <meta name="description" content={description}/>

    <meta property="og:title" content={pageTitle} />
    <meta property="og:type" content={ogType} />
    <meta property="og:url" content={pageUrl} />
    <meta property="og:description" content={description} />
    <meta property="og:site_name" content={baseTitle} />
	<meta property="og:locale" content={"ja_JP"} />
    <meta property="og:image" content={ogpUrl} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={pageTitle} />

    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={pageTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogpUrl} />
    <link rel="icon" href="/Favicon.png" />

    <meta name="generator" content={Astro.generator} />

	<script>
		(function(d) {
			var config = {
			kitId: 'nyw6mhh',
			scriptTimeout: 3000,
			async: true
			},
			h=d.documentElement,t=setTimeout(function(){h.className=h.className.replace(/\bwf-loading\b/g,"")+" wf-inactive";},config.scriptTimeout),tk=d.createElement("script"),f=false,s=d.getElementsByTagName("script")[0],a;h.className+=" wf-loading";tk.src='https://use.typekit.net/'+config.kitId+'.js';tk.async=true;
			/* @ts-ignore */
			tk.onload=tk.onreadystatechange=function(){a=this.readyState;if(f||a&&a!="complete"&&a!="loaded")return;f=true;clearTimeout(t);try{Typekit.load(config)}catch(e){}};s.parentNode.insertBefore(tk,s)
		})(document);
	</script>

    <meta name="robots" content="noindex, nofollow" />
  </head>
	<body>
		<Header />
		<main id="pageWrapper">
			<slot />
		</main>
		<Footer />
	</body>
</html>

<script>
import { isSp_set } from "../utils/isSp";
import { pageTransition_set } from "../utils/pageTransition";
import { slTexts_init } from "../scripts/slTexts";
import { cta_init } from "../scripts/cta";
import { accordion_init } from "../utils/accordion";
import { pageTop_init, pageTop_enter } from "../scripts/page.top";
import { showImg_init } from "../scripts/showImg";
import { toggleBgSection_init } from "../scripts/toggleBgSection";
import { header_enter, header_init } from "../scripts/header";
import { initProgressiveImages_init } from "../utils/initProgressiveImages";
import { isFirstSession } from "../utils/isFiersSettion";

initProgressiveImages_init();
window.addEventListener('DOMContentLoaded', () => {
	setTimeout(() => {
		const pageId = document.getElementById('pageContainer')?.getAttribute('data-pageId') || ""
		function page_beforeEnter(resolve: (value: unknown) => void) {
			isSp_set();
			pageTransition_set();
			slTexts_init();
			cta_init();
			accordion_init();
			showImg_init();
			toggleBgSection_init();
			header_init();

			switch (pageId) {
				case "top":
					pageTop_init();
					break;
				default:
					break;
			}
			resolve(null);
		}
		function page_enter() {
			setTimeout(() => {
				header_enter();
				switch (pageId) {
					case "top":
						pageTop_enter();
						break;
					default:
						break;
				}
			}, isFirstSession() ? 500 : 0)
		}
		Promise.resolve().then(() => new Promise(page_beforeEnter).then(page_enter));
	})
})
</script>